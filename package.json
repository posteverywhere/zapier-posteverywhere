{
  "name": "zapier-posteverywhere",
  "version": "1.0.0",
  "description": "PostEverywhere integration for Zapier: schedule and publish social media posts to Instagram, TikTok, YouTube, LinkedIn, Facebook, X, Threads, Pinterest, Bluesky, Telegram, Discord and WordPress.",
  "homepage": "https://posteverywhere.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/posteverywhere/zapier-posteverywhere.git"
  },
  "author": {
    "name": "PostEverywhere",
    "email": "support@posteverywhere.ai"
  },
  "main": "index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "jest --testTimeout 10000"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zapier-platform-core": "19.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nock": "^13.5.6"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./test/setup.js"
    ],
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  }
}
